{
  "name": "payload-inline-visual-editor",
  "version": "1.0.1",
  "description": "Inline visual editor plugin for Payload CMS 3.x — click-to-edit and block operations layered on core Live Preview",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "cms",
    "visual-editor",
    "visual-editing",
    "inline-editing",
    "live-preview"
  ],
  "homepage": "https://github.com/what-digital/payload-inline-visual-editor#readme",
  "bugs": "https://github.com/what-digital/payload-inline-visual-editor/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/what-digital/payload-inline-visual-editor.git",
    "directory": "packages/plugin"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "import": "./dist/exports/client.js",
      "default": "./dist/exports/client.js"
    },
    "./rsc": {
      "types": "./dist/exports/rsc.d.ts",
      "import": "./dist/exports/rsc.js",
      "default": "./dist/exports/rsc.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths --copy-files",
    "build:types": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "watch": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths --copy-files --watch"
  },
  "dependencies": {
    "@payload-inline-visual-editor/core": "workspace:*"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.85.0",
    "next": "^15.2.9 || ^16.0.0",
    "payload": "^3.85.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/ui": "^3.91.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "next": "^16.4.2",
    "payload": "^3.91.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
